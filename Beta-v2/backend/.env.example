# Copy this file to .env and fill in local credentials for Beta-v2 backend.

HOST=127.0.0.1
PORT=8010
DATABASE_URL=sqlite:///./beta_v2_osint.db
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# SOC OPERATOR AUTHENTICATION & TAMPER-EVIDENT AUDIT
# Generate two different random values of at least 32 bytes. Never reuse a
# provider key or commit either value. Set AUTH_COOKIE_SECURE=true behind HTTPS.
AUTH_SESSION_SECRET=
AUDIT_HMAC_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=900
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_PBKDF2_ITERATIONS=600000
# Optional path overrides; defaults live under backend/runtime/ and are ignored.
# AUTH_USERS_FILE=D:/secure/beta-v2/soc_users.json
# AUDIT_LOG_PATH=D:/secure/beta-v2/security_audit.jsonl

# AI ENGINES
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# APIFY SCRAPERS
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_HTTP_TIMEOUT_SECONDS=60
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_WAIT_SECONDS=20
APIFY_LINKEDIN_PROFILE_ACTOR_ID=apimaestro/linkedin-profile-detail
APIFY_LINKEDIN_POSTS_ACTOR_ID=bebity/linkedin-post-search-scraper

# ENRICHMENT & VERIFICATION SERVICES
SIGNALHIRE_API_KEY=
ROCKETREACH_API_KEY=
SERPAPI_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
RAPIDAPI_KEY=

# ISOLATED EMAIL INVESTIGATION
# Server ceilings are immutable; callers may only lower the dork query count.
EMAIL_INVESTIGATION_DORK_ENABLED=true
EMAIL_INVESTIGATION_MAX_DORK_QUERIES=3
EMAIL_INVESTIGATION_MAX_DORK_CALLS=6
EMAIL_INVESTIGATION_MAX_DORK_RESULTS=15
EMAIL_INVESTIGATION_HTTP_TIMEOUT_SECONDS=10
# Sensitive breach collection is opt-in and requires a dedicated LeakOSINT token.
EMAIL_INVESTIGATION_BREACH_ENABLED=false
EMAIL_INVESTIGATION_BREACH_API_KEY=

# TELEGRAM CTI & MTPROTO
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_CTI_API_KEY=
TELEGRAM_CTI_ENABLED=true
TELEGRAM_CTI_DEFAULT_LIMIT=100
