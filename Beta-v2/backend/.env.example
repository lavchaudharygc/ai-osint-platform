# Copy this file to .env and fill in local credentials for Beta-v2 backend.

HOST=127.0.0.1
PORT=8010
DATABASE_URL=sqlite:///./beta_v2_osint.db
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# PII-SAFE OPERATIONAL DIAGNOSTICS (separate from the security audit)
APP_LOG_ENABLED=true
APP_LOG_LEVEL=INFO
APP_LOG_MAX_BYTES=5242880
APP_LOG_BACKUP_COUNT=5
# Optional; default: backend/runtime/application.log
# APP_LOG_PATH=D:/secure/beta-v2/application.log

# SOC OPERATOR AUTHENTICATION & TAMPER-EVIDENT AUDIT
# Generate two different random values of at least 32 bytes. Never reuse a
# provider key or commit either value. Set AUTH_COOKIE_SECURE=true behind HTTPS.
AUTH_USER=uppolice
AUTH_PASSWORD=test
AUTH_SESSION_SECRET=
AUDIT_HMAC_KEY=
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_PBKDF2_ITERATIONS=600000
# Optional path overrides; defaults live under backend/runtime/ and are ignored.
# AUTH_USERS_FILE=D:/secure/beta-v2/soc_users.json
# AUDIT_LOG_PATH=D:/secure/beta-v2/security_audit.jsonl

# AI ENGINES
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# APIFY SCRAPERS
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_HTTP_TIMEOUT_SECONDS=60
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_WAIT_SECONDS=20
# Read-only account-limit checks are cached. Each paid Actor run also has a
# hard charge ceiling; lower this if your operational budget requires it.
APIFY_QUOTA_CHECK_TTL_SECONDS=300
APIFY_QUOTA_CHECK_TIMEOUT_SECONDS=10
APIFY_MAX_TOTAL_CHARGE_USD_PER_RUN=1.0
APIFY_INSTAGRAM_PROFILE_ACTOR_ID=apify/instagram-profile-scraper
APIFY_INSTAGRAM_POSTS_ACTOR_ID=apify/instagram-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_FACEBOOK_PAGES_ACTOR_ID=apify/facebook-pages-scraper
APIFY_FACEBOOK_POSTS_ACTOR_ID=apify/facebook-posts-scraper
APIFY_TWITTER_ACTOR_ID=automation-lab/twitter-scraper
APIFY_LINKEDIN_PROFILE_ACTOR_ID=apimaestro/linkedin-profile-detail
APIFY_LINKEDIN_POSTS_ACTOR_ID=bebity/linkedin-post-search-scraper
# Target Scan starts at most one posts Actor after a confirmed LinkedIn profile.
APIFY_LINKEDIN_POSTS_LIMIT=15

# GITHUB PUBLIC DATA (official GitHub REST API only; no provider fallback)
# GITHUB_API_TOKEN is optional for public profiles, but authenticated requests
# receive GitHub's higher account rate limit. Use a read-only fine-grained token.
GITHUB_ENABLED=true
GITHUB_API_TOKEN=
GITHUB_TIMEOUT_SECONDS=12
# One profile request plus, when budget permits, one repositories request and
# one public-events request. Values cannot exceed the code-enforced ceilings.
GITHUB_MAX_REQUESTS_PER_SCAN=3
GITHUB_MAX_REPOSITORIES=10
GITHUB_MAX_EVENTS=10
GITHUB_USER_AGENT=UPPoliceCyberCell-OSINT/2.0

# YOUTUBE PUBLIC DATA (official YouTube Data API v3 only; no fallback)
# Create a Google Cloud API key with YouTube Data API v3 enabled. Restrict the
# key to this API and to the backend's deployment IP where practical.
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=12
# One channel lookup, one uploads-playlist request, and one batched video-detail
# request. The collector does not use search.list or follow pagination tokens.
YOUTUBE_MAX_REQUESTS_PER_SCAN=3
YOUTUBE_VIDEOS_LIMIT=10

# ENRICHMENT & VERIFICATION SERVICES
# Target Scan never calls both contact enrichers for one request: an exact
# email/phone is eligible for SignalHire, while a confirmed LinkedIn /in/ URL
# is eligible for RocketReach. Missing keys do not trigger provider fallback.
SIGNALHIRE_API_KEY=
ROCKETREACH_API_KEY=
SERPAPI_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
RAPIDAPI_KEY=
# Successful enrichment/verification results only; process memory, never disk.
# Set either value to 0 to disable reuse. CTI/breach responses are never cached.
CONTACT_RESULT_CACHE_TTL_SECONDS=900
CONTACT_RESULT_CACHE_MAX_ENTRIES=256

# TARGET SCAN GOOGLE DORKING (SerpAPI only; no provider fallback)
# Five distinct searches can return up to ten rows each, then results are
# normalized, de-duplicated, and capped locally at 40 unique public URLs.
DORKING_ENABLED=true
DORKING_TIMEOUT_SECONDS=15
DORKING_MAX_QUERIES=5
DORKING_RESULTS_PER_QUERY=10
DORKING_MAX_RESULTS=40
DORKING_COUNTRY_CODE=in

# ISOLATED FULL-NAME PERSON SEARCH (SerpAPI only; no provider fallback)
PERSON_SEARCH_ENABLED=true
PERSON_SEARCH_TIMEOUT_SECONDS=15
PERSON_SEARCH_RESULTS_PER_QUERY=5
PERSON_SEARCH_MAX_QUERIES=5
PERSON_SEARCH_MAX_PROFILES=20

# ISOLATED EMAIL INVESTIGATION
# Server ceilings are immutable; callers may only lower the dork query count.
EMAIL_INVESTIGATION_DORK_ENABLED=true
EMAIL_INVESTIGATION_MAX_DORK_QUERIES=3
EMAIL_INVESTIGATION_MAX_DORK_CALLS=6
EMAIL_INVESTIGATION_MAX_DORK_RESULTS=15
EMAIL_INVESTIGATION_HTTP_TIMEOUT_SECONDS=10
# Sensitive breach collection is opt-in and requires a dedicated LeakOSINT token.
EMAIL_INVESTIGATION_BREACH_ENABLED=false
EMAIL_INVESTIGATION_BREACH_API_KEY=

# TELEGRAM CTI & MTPROTO
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_CTI_API_KEY=
TELEGRAM_CTI_ENABLED=true
TELEGRAM_CTI_DEFAULT_LIMIT=50
# Per-investigation CTI safety ceilings. Keep these conservative to protect
# provider quota; incoming requests can only use lower values.
TELEGRAM_CTI_MAX_SEED_IDENTIFIERS=3
TELEGRAM_CTI_MAX_DEPTH=2
TELEGRAM_CTI_MAX_LOGICAL_SEARCHES=5
TELEGRAM_CTI_MAX_HTTP_ATTEMPTS=6
TELEGRAM_CTI_MAX_HTTP_ATTEMPTS_PER_HOUR=30
TELEGRAM_CTI_MAX_RETRIES_PER_QUERY=1
TELEGRAM_CTI_MAX_CONCURRENCY=1
TELEGRAM_CTI_MIN_REQUEST_INTERVAL_SECONDS=0.5
TELEGRAM_CTI_COOLDOWN_SECONDS=300
# CTI records stay local by default. Set true only after an approved privacy
# review if external Groq-based CTI filtering is explicitly required.
CTI_INDIAN_FILTERING_ENABLED=true
CTI_EXTERNAL_AI_FILTERING_ENABLED=false
