# Copy this file to .env and fill in local credentials for Beta-v2 backend.

HOST=127.0.0.1
PORT=8010
DATABASE_URL=sqlite:///./beta_v2_osint.db

# AI ENGINES
GROQ_API_KEY=your-groq-key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# APIFY SCRAPERS
APIFY_API_TOKEN=your-apify-token
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_HTTP_TIMEOUT_SECONDS=60
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_WAIT_SECONDS=20
APIFY_LINKEDIN_PROFILE_ACTOR_ID=apimaestro/linkedin-profile-detail
APIFY_LINKEDIN_POSTS_ACTOR_ID=bebity/linkedin-post-search-scraper

# ENRICHMENT & VERIFICATION SERVICES
SIGNALHIRE_API_KEY=your-signalhire-key
ROCKETREACH_API_KEY=your-rocketreach-key
SERPAPI_KEY=your-serpapi-key
HUNTER_API_KEY=your-hunter-key
ZEROBOUNCE_API_KEY=your-zerobounce-key
RAPIDAPI_KEY=your-rapidapi-key

# TELEGRAM CTI & MTPROTO
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
TELEGRAM_CTI_API_KEY=your-telegram-cti-api-key
TELEGRAM_CTI_ENABLED=true
TELEGRAM_CTI_DEFAULT_LIMIT=100
