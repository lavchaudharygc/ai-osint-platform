# Copy this file to .env and fill in local values.
# Never commit your real .env file.

HOST=127.0.0.1
PORT=8010

RAPIDAPI_KEY=your-rapidapi-key
FLASHAPI_HOST=flashapi1.p.rapidapi.com
FLASHAPI_BASE_URL=https://flashapi1.p.rapidapi.com
FLASHAPI_ENDPOINT_PATH=ig/info_username/
FLASHAPI_USERNAME_PARAM=user
FLASHAPI_NOCORS=false
FLASHAPI_TIMEOUT_SECONDS=15

# Optional future integrations
TWITTER_BEARER_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
LOCAL_DATABASE_URL=sqlite:///./osint.db
TELEGRAM_BOT_TOKEN=
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_RESULTS_PER_QUERY=5
BRIGHTDATA_SERP_API_KEY=
BRIGHTDATA_SERP_BASE_URL=https://api.brightdata.com/request
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_SERP_TARGET_URL=https://www.google.com/search?q={query}
DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/osint
REDIS_URL=redis://localhost:6379/0
